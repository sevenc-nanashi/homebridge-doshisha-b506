{
  "name": "homebridge-doshisha-b506",
  "displayName": "Homebridge Doshisha B506",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Doshisha B506をNature Remo経由で操作するHomebridgeプラグイン。",
  "author": "Nanashi.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.10.0",
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "pkgroll",
    "prepublishOnly": "pnpm run lint && pnpm run build",
    "watch": "pnpm run build && pnpm link && nodemon",
    "tools:config": "node --experimental-strip-types ./config.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "homebridge-lib": "^7.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^22.13.5",
    "dequal": "^2.0.3",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "pkgroll": "^2.12.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
